# Monster behaviour for the open content pack, standing in for the
# original's Control.aid. Our own numbers, not taken from either game.
#
# [list <name>] starts a list; walk= is the speed it walks home at.
# on=<event> <action> key=value ... adds a choice for that event:
#   events: decide, wander-done, retreat-done, approach-done, waiting,
#           wandering, retreating, approaching, animation-done, hit
#   actions: wait, wander, attack, attack2, attack3, magic, magic2, magic3,
#            stop, retreat, approach, home
#   keys: priority (a higher one rules out lower ones), weight (odds),
#         duration (ticks), speed (world units a tick), pause and extra
#         (wander pause and random extra), hp=<min>..<max> (percent),
#         range=<min>..<max> (gap to the player in world units)
# Ticks are the original's, 30 a second, as in Control.aid. Distances: a map
# tile is 480 world units; the hero walks 20 a tick and runs 40, and the
# original's monsters mostly move at 15 to 25.

[list goblin]
walk=20
on=decide attack priority=2 range=..60
on=decide approach weight=4 duration=45 speed=15 range=..1800
on=decide wander duration=120 speed=15 pause=15 extra=45
on=approaching attack priority=2 range=..60
on=hit approach priority=1 duration=30 speed=20 range=..2400

[list skeleton]
walk=20
on=decide attack priority=2 range=..80
on=decide approach weight=6 duration=60 speed=15 range=..2000
on=decide wait weight=1 duration=30
on=approaching attack priority=2 range=..80

# Spell casters: monsters with spells= follow one of these, picked by
# tools/content/caster_ai.py from the spells they know. Spells that burst
# round the caster (Hell Fire, Ice Blast) are cast close up, the rest from
# further off, as the original's casters keep them.

# One spell that flies or reaches (slot a).
[list mage]
walk=25
on=decide attack priority=2 range=..60
on=decide magic priority=1 weight=2 range=200..1200
on=decide approach priority=1 weight=3 duration=45 speed=20 range=..1800
on=decide wander duration=120 speed=20 pause=15 extra=45
on=approaching attack priority=2 range=..60
on=hit approach priority=1 duration=30 speed=20 range=..2400

# Two spells that fly or reach: a nearer, b further.
[list mage-two]
walk=25
on=decide attack priority=2 range=..60
on=decide magic priority=1 weight=2 range=200..700
on=decide magic2 priority=1 weight=2 range=701..1200
on=decide approach priority=1 weight=3 duration=45 speed=20 range=..1800
on=decide wander duration=120 speed=20 pause=15 extra=45
on=approaching attack priority=2 range=..60
on=hit approach priority=1 duration=30 speed=20 range=..2400

# A burst close up (a) and a spell from further off (b).
[list mage-near-far]
walk=25
on=decide attack priority=2 range=..60
on=decide magic priority=2 range=..150
on=decide magic2 priority=1 weight=2 range=200..1200
on=decide approach priority=1 weight=3 duration=45 speed=20 range=..1800
on=decide wander duration=120 speed=20 pause=15 extra=45
on=approaching attack priority=2 range=..60
on=hit approach priority=1 duration=30 speed=20 range=..2400

# Three spells: a burst close up (a), then b and c further and further off.
[list mage-three]
walk=25
on=decide attack priority=2 range=..60
on=decide magic priority=2 range=..150
on=decide magic2 priority=1 weight=2 range=200..700
on=decide magic3 priority=1 weight=2 range=701..1300
on=decide approach priority=1 weight=3 duration=45 speed=20 range=..1800
on=decide wander duration=120 speed=20 pause=15 extra=45
on=approaching attack priority=2 range=..60
on=hit approach priority=1 duration=30 speed=20 range=..2400

# The same with the burst last (c) and the furthest first (a).
[list mage-three-burst-last]
walk=25
on=decide attack priority=2 range=..60
on=decide magic3 priority=2 range=..150
on=decide magic2 priority=1 weight=2 range=200..700
on=decide magic priority=1 weight=2 range=701..1300
on=decide approach priority=1 weight=3 duration=45 speed=20 range=..1800
on=decide wander duration=120 speed=20 pause=15 extra=45
on=approaching attack priority=2 range=..60
on=hit approach priority=1 duration=30 speed=20 range=..2400

# Throwers: monsters with shot= (tools/content/caster_ai.py gives them
# this list) keep their distance and throw from there, backing off from a
# hero who comes close and closing in on one who is far off.
[list thrower]
walk=20
on=decide attack priority=2 range=700..1400
on=decide retreat priority=2 duration=75 speed=15 range=..699
on=decide approach priority=1 duration=60 speed=20 range=1401..2400
on=decide wander duration=90 speed=15 pause=15 extra=38
on=approaching attack priority=2 range=700..1400
on=retreating attack priority=2 range=700..1400
on=hit retreat priority=1 duration=45 speed=20 range=..699
# Art made for this project: see tools/art.
name=ShadowFlare open content
start=10000000
projection=15,10
# What monsters leave behind, standing in for the original's drop tables
# (Table.Tbd tables 30 and 31): see docs/content.md. Each [drops <list>] is
# used by the monsters whose enemy= line names that list (the field after
# the AI list, the level the hero should be at there). Like the original, a list has its rolls, each
# dropping something `chance` percent of the time (a little more: as in
# the original, 15 means 16 in 100), as one of its picks chosen at random.
# Monsters with no gold of their own drop gold= (chance, least, most).
# An `any` pick may give a normal, magic or unique item, as the original's
# usually may; a fifth number limits that (110: no normal items, 11: no
# uniques). How often each comes is down to the items' weight=.

[drops 1]
rolls=1
chance=15
gold=10,3,8
pick=consumable,0        # Healing Potion
pick=consumable,0
pick=consumable,10000000 # Mana Potion
pick=consumable,10000000
pick=special,1          # Mine (into the hero's mines, not the bag)
pick=any,any,1,1         # a weapon, armour or ring of item level 1-1, by weight
pick=any,any,1,1
pick=any,any,1,1

