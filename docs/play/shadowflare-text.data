# --------------------------------------------------------------------- healer
# temp:20 the answer, temp:21 which box is showing, temp:23 whether the
# hero is hurt, temp:26 the blessing said last.

[message 200]
You must be the new one the army hired. I keep the shrine.

Come to me whenever you need your strength and spirit
restored.

....

[message 201]
Something has been preying on us out on the road
north-east of town. An old trader there barely got away.

Would you put an end to it?

[message 202]
Goblins at the ruins stole the stone from my shrine.
I am sorry, but without it I cannot heal you.

[message 203]
!! Is that the shrine's stone? You found it?
Oh, thank you!

[message 204]
Please take this. It is a small thing, but it may help you.

[message 205]
Thanks to you, this town may finally mend.
I cannot thank you enough.

[message 206]
I hear you may be going to Cold Svalt.
Take this along. It will serve you well.

[message 207]
Spirit of the shrine, keeper of life,
close these wounds and drive out the hurt!

[message 208]
Go with the shrine's blessing.

[message 209]
There is a bright light in you. Trust it,
and keep doing your best.

[sentence healer]
on=talk healer
C_STOP healer
C_SETANGLETO healer 0
IF quest:0 ! 0 @healer-later
IF quest:0 = 0 @healer-first

[sentence healer-first]
TALK msg:200 temp:20 0 0 -1 -1
SETFLAG temp:21 40

[sentence healer-later]
SETFLAG temp:21 -1
IF quest:3 ! 0 @healer-stone
IF temp:21 = -1 @healer-farewell
IF temp:21 = -1 @healer-bless

# The shrine stone (quest 2).
[sentence healer-stone]
IF quest:2 = 1 @healer-stone-check
IF quest:2 = 0 @healer-stone-ask

[sentence healer-stone-check]
CHECKITEMEXIST 4 99000001 temp:25
IF temp:25 = 1 @healer-stone-back
IF temp:25 ! 1 @healer-stone-wait

[sentence healer-stone-back]
TALK msg:203 temp:20 0 0 -1 -1
SETFLAG temp:21 30
DELETEITEM 4 99000001
SETQUESTFLAG 2 2 0

[sentence healer-stone-wait]
TALK msg:202 temp:20 0 0 -1 -1
SETFLAG temp:21 0

[sentence healer-stone-ask]
GETPLAYERLEVEL temp:25
IF temp:25 > 5 @healer-stone-give

[sentence healer-stone-give]
TALK msg:202 temp:20 0 0 -1 -1
SETFLAG temp:21 0
SETQUESTFLAG 2 1 0
DRAWQUESTNAME 2

# Her Cold Svalt-bound gift, once the commander has sent the hero on.
[sentence healer-farewell]
IF quest:3 = 2 @healer-farewell-2

[sentence healer-farewell-2]
IF save:2 = 1 @healer-farewell-3

[sentence healer-farewell-3]
IF save:7 = 0 @healer-farewell-4

[sentence healer-farewell-4]
TALK msg:205 temp:20 0 0 -1 -1
SETFLAG temp:21 10
SETFLAG save:7 1

# Healing when the hero or the companion is hurt or spent; otherwise a
# blessing (the first after a healing, then the second from then on).
[sentence healer-bless]
SETFLAG temp:21 0
SETFLAG temp:23 0
GETPLAYERLIFE temp:24 temp:25
IF temp:24 ! temp:25 @healer-hurt
GETPLAYERMENTAL temp:24 temp:25
IF temp:24 ! temp:25 @healer-hurt
GETPARTNERLIFE temp:24 temp:25
IF temp:24 ! temp:25 @healer-hurt
IF temp:23 = 1 @healer-chant
IF temp:23 = 0 @healer-blessing

[sentence healer-hurt]
SETFLAG temp:23 1

[sentence healer-chant]
TALK msg:207 temp:20 0 0 -1 -1
SETFLAG temp:26 msg:207
SETFLAG temp:21 20

[sentence healer-blessing]
IF temp:26 = -1 @healer-blessing-1
IF temp:26 = msg:207 @healer-blessing-1
TALK temp:26 temp:20 0 0 -1 -1
IF temp:26 = msg:208 @healer-blessing-2

[sentence healer-blessing-1]
SETFLAG temp:26 msg:208

[sentence healer-blessing-2]
SETFLAG temp:26 msg:209

[sentence healer-end]
on=talk-end healer
SETFLAG temp:22 temp:21
SETFLAG temp:21 0
IF temp:22 = 0 @healer-done
IF temp:22 = 40 @healer-mission
IF temp:22 = 30 @healer-thanks
IF temp:22 = 20 @healer-heal
IF temp:22 = 11 @healer-done
IF temp:22 = 10 @healer-gift

[sentence healer-done]
C_MOVABLE healer

[sentence healer-mission]
TALK msg:201 temp:20 0 0 -1 -1
SETQUESTFLAG 0 1 0
DRAWQUESTNAME 0

[sentence healer-thanks]
TALK msg:204 temp:20 0 0 -1 -1
SETFLAG temp:3 x:healer
SETFLAG temp:4 y:healer
ADD temp:3 200
CREATEITEM 2 1100001 temp:3 temp:4 -1 -1

[sentence healer-heal]
C_MOVABLE healer
# The healer casts (person chart 3) as the hero is healed.
C_ACTIONREQ healer 4 -1 -1 -1 -1
HEALLIFE
HEALMENTAL
PLAYSOUND 24 0 x:healer y:healer

[sentence healer-gift]
SETFLAG temp:21 11
TALK msg:206 temp:20 0 0 -1 -1
SETFLAG temp:3 x:healer
SETFLAG temp:4 y:healer
ADD temp:3 200
CREATEITEM 2 1100002 temp:3 temp:4 -1 -1

[message 30]
Remote Town

[sentence gate-found]
on=judge gate-ground
SETFLAG warp:0 1
MESSAGEBOX gate 0 -160 msg:30 224 224 224 3000

[sentence gate]
on=talk gate
WARPGATE 0

# The kennel, as the original's: three dogs, each offering its status,
# two boxes about companions and a swap (CHANGEPARTNER), and a small dog
# off on its own elsewhere in town who does the same. The one that is the
# hero's companion is not there (it is out with the hero). temp:40 says
# which of a dog's boxes is showing (0 its menu, 1 the first explanation,
# 2 the last); temp:41 is the answer.

[message 40]
Ash
~See how I'm doing~
~Tell me about yourself~
~Swap partners~
~Leave~

[message 41]
The more we fight beside you,
the stronger we grow.

[message 42]
Each of us is good at something different.
Pick the one that suits the way you fight.

[sentence ash]
on=talk ash
C_STOP ash
C_SETANGLETO ash 0
SETFLAG temp:40 0
TALK msg:40 temp:41 1 3 -1 -1

[sentence ash-end]
on=talk-end ash
IF temp:40 = 2 @ash-done
IF temp:40 = 1 @ash-more
IF temp:40 = 0 @ash-choice

[sentence ash-done]
C_MOVABLE ash

[sentence ash-more]
SETFLAG temp:40 2
TALK msg:42 temp:41 1 -1 -1 -1

[sentence ash-choice]
IF temp:41 = 0 @ash-status
IF temp:41 = 1 @ash-tell
IF temp:41 = 2 @ash-swap
IF temp:41 = 3 @ash-done

[sentence ash-status]
SETFLAG temp:40 2
TALKPARTNERSTATUS 0 temp:41

[sentence ash-tell]
SETFLAG temp:40 1
TALK msg:41 temp:41 1 -1 -1 -1

[sentence ash-swap]
CHANGEPARTNER 0
C_MOVABLE ash

# Hidden while it is the hero's companion, back once it is swapped out.
[sentence ash-tick]
on=tick
GETPARTNERKIND temp:42
IF shown:ash = 1 @ash-hide
IF shown:ash = 0 @ash-show

[sentence ash-hide]
IF temp:42 = 0 @ash-off

[sentence ash-off]
SETINACTIVE ash

[sentence ash-show]
IF temp:42 ! 0 @ash-on

[sentence ash-on]
SETACTIVE ash

[message 43]
Soot
~See how I'm doing~
~Tell me about yourself~
~Swap partners~
~Leave~

[message 44]
Hold Tab and click, and we leap and kick whatever is there.
We can land on a switch or a button, too.

[message 45]
Press Space and we go after the enemy.
Press it again and we fall back to you.

[sentence soot]
on=talk soot
C_STOP soot
C_SETANGLETO soot 0
SETFLAG temp:40 0
TALK msg:43 temp:41 1 3 -1 -1

[sentence soot-end]
on=talk-end soot
IF temp:40 = 2 @soot-done
IF temp:40 = 1 @soot-more
IF temp:40 = 0 @soot-choice

[sentence soot-done]
C_MOVABLE soot

[sentence soot-more]
SETFLAG temp:40 2
TALK msg:45 temp:41 1 -1 -1 -1

[sentence soot-choice]
IF temp:41 = 0 @soot-status
IF temp:41 = 1 @soot-tell
IF temp:41 = 2 @soot-swap
IF temp:41 = 3 @soot-done

[sentence soot-status]
SETFLAG temp:40 2
TALKPARTNERSTATUS 1 temp:41

[sentence soot-tell]
SETFLAG temp:40 1
TALK msg:44 temp:41 1 -1 -1 -1

[sentence soot-swap]
CHANGEPARTNER 1
C_MOVABLE soot

# Hidden while it is the hero's companion, back once it is swapped out.
[sentence soot-tick]
on=tick
GETPARTNERKIND temp:42
IF shown:soot = 1 @soot-hide
IF shown:soot = 0 @soot-show

[sentence soot-hide]
IF temp:42 = 1 @soot-off

[sentence soot-off]
SETINACTIVE soot

[sentence soot-show]
IF temp:42 ! 1 @soot-on

[sentence soot-on]
SETACTIVE soot

[message 46]
Amber
~See how I'm doing~
~Tell me about yourself~
~Swap partners~
~Leave~

[message 47]
Meat is what we like best.
Feed us some and our wounds close.

[message 48]
The better the meat, the more it heals us.

[sentence amber]
on=talk amber
C_STOP amber
C_SETANGLETO amber 0
SETFLAG temp:40 0
TALK msg:46 temp:41 1 3 -1 -1

[sentence amber-end]
on=talk-end amber
IF temp:40 = 2 @amber-done
IF temp:40 = 1 @amber-more
IF temp:40 = 0 @amber-choice

[sentence amber-done]
C_MOVABLE amber

[sentence amber-more]
SETFLAG temp:40 2
TALK msg:48 temp:41 1 -1 -1 -1

[sentence amber-choice]
IF temp:41 = 0 @amber-status
IF temp:41 = 1 @amber-tell
IF temp:41 = 2 @amber-swap
IF temp:41 = 3 @amber-done

[sentence amber-status]
SETFLAG temp:40 2
TALKPARTNERSTATUS 2 temp:41

[sentence amber-tell]
SETFLAG temp:40 1
TALK msg:47 temp:41 1 -1 -1 -1

[sentence amber-swap]
CHANGEPARTNER 2
C_MOVABLE amber

# Hidden while it is the hero's companion, back once it is swapped out.
[sentence amber-tick]
on=tick
GETPARTNERKIND temp:42
IF shown:amber = 1 @amber-hide
IF shown:amber = 0 @amber-show

[sentence amber-hide]
