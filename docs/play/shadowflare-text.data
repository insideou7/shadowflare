hit=240,0
defense=40,24,24,24,24,24,24,24,24,24,32
evasion=20,0
magic_attack=90,0
magic_defense=40,24,24,24,24,24,24,24,24,24,32
magic_hit=240,0
magic_evasion=20,0
element=0                # fire
stun_chance=70
stun_length=14
stun_uncapped=0
jump_area=880
experience=90

