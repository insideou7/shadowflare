# What the name over each kind of monster (Character/ENEMY/<kind>) says
# with the mouse on it, standing in for the names the original's
# placements carry: see docs/content.md.
#
# kind=name,height[,red,green,blue]: the height is how many pixels above
# its feet the name floats (a little over the top of its picture); the
# colour is light grey unless given.

-1=Burrow,40
0=Giant Fly,44
1=Goblin,55
2=Ghoul,52
3=Demon,123
4=Golem,99
5=Goblin Shaman,59
