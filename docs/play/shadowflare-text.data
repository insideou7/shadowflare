# How to draw the original game's maps with this pack's art, for players
# who have the original: its maps, monsters and people, in our art.
# See "Drawing the original game with this art" in docs/content.md.

props=Map/props.sheet

# Ground textures: a 4 x 4 block of tiles from a ground sheet.
[material dirt]
tiles=Map/ground.sheet,0
[material grass]
tiles=Map/ground.sheet,240
[material rubble]
tiles=Map/floor.sheet,0
[material brick]
tiles=Map/floor.sheet,240
[material gravel]
tiles=Map/cavefloor.sheet,0
[material rock]
tiles=Map/cavefloor.sheet,240
[material coal]
tiles=Map/cavefloor.sheet,256
[material mine]
tiles=Map/cavefloor.sheet,496
[material grit]
tiles=Map/fortfloor.sheet,0
[material paving]
tiles=Map/fortfloor.sheet,240
[material soil]
tiles=Map/wildsfloor.sheet,0
[material heath]
tiles=Map/wildsfloor.sheet,240
[material sand]
tiles=Map/wildsfloor.sheet,256
[material lawn]
tiles=Map/wildsfloor.sheet,496
[material water]
tiles=Map/wildsfloor.sheet,512
[material dryearth]
tiles=Map/wildsfloor.sheet,768
[material moss]
tiles=Map/deepfloor.sheet,0
[material earth]
tiles=Map/deepfloor.sheet,240
[material stone]
tiles=Map/castlefloor.sheet,0
[material flagstones]
tiles=Map/castlefloor.sheet,240

# The original's ground banks: the materials each is painted with and
# their average colour there (red, green, blue). Each pixel gets the
# material whose colour is nearest, and our texture is tinted to that
# colour.
[ground 00f_ground.njp]
grass=44,50,14
dirt=47,35,19
[ground 00d_ground.njp]
brick=72,60,40
[ground 00y_ground.njp]
stone=57,56,59
# The third area's banks are drawn in shades of one another, so they
# share their materials: the colour decides, not the bank.
[ground 3rdmap_00.njp]
heath=44,48,14
lawn=23,48,3
