person=1000000,3605,3604,7,rust
# Cold Svalt Town's warp gate, as the original's: walking up to it finds
# it (warp:4) and shows its name over it, and a click on it opens the
# GATE window.

object=2241,3926,2538,4177,gate
# Judge area only: unusable, so a held click on the square still walks.
object=1040,2537,3340,5037,gate-ground,states=0/0/0

# The warehouse by the merchant's (the original's object 300, which opens
# the hero's storage), drawn as a long crate.
object=10065,10590,10385,10910,warehouse,long_crate

# The healer's last line (msg:182 when she heals).
temp=16,-1

[message 1]
Cold Svalt Town

[sentence gate-found]
on=judge gate-ground
SETFLAG warp:4 1
MESSAGEBOX gate 0 -160 msg:1 224 224 224 3000

[sentence gate]
on=talk gate
WARPGATE 0

# The dog waiting in town, as the original's: like
# Remote Town's kennel dogs, it offers its status, two boxes about itself
# and a swap. temp:40 says which of its boxes is showing; temp:41 is the
# answer.

[message 40]
Rust
~See how I'm doing~
~Tell me about yourself~
~Swap partners~
~Leave~

[message 41]
I'm not like the dogs back in Remote Town.

[message 42]
...Though, to be fair, a few of us here
could not keep up with them.

[sentence rust]
on=talk rust
C_STOP rust
C_SETANGLETO rust 0
SETFLAG temp:40 0
TALK msg:40 temp:41 1 3 -1 -1

[sentence rust-end]
on=talk-end rust
IF temp:40 = 2 @rust-done
IF temp:40 = 1 @rust-more
IF temp:40 = 0 @rust-choice

[sentence rust-done]
C_MOVABLE rust

[sentence rust-more]
SETFLAG temp:40 2
TALK msg:42 temp:41 1 -1 -1 -1

[sentence rust-choice]
IF temp:41 = 0 @rust-status
IF temp:41 = 1 @rust-tell
IF temp:41 = 2 @rust-swap
IF temp:41 = 3 @rust-done

[sentence rust-status]
SETFLAG temp:40 2
TALKPARTNERSTATUS 3 temp:41

[sentence rust-tell]
SETFLAG temp:40 1
TALK msg:41 temp:41 1 -1 -1 -1

[sentence rust-swap]
CHANGEPARTNER 3
C_MOVABLE rust

# Hidden while it is the hero's companion, back once it is swapped out.
[sentence rust-tick]
on=tick
GETPARTNERKIND temp:42
IF shown:rust = 1 @rust-hide
IF shown:rust = 0 @rust-show

[sentence rust-hide]
IF temp:42 = 3 @rust-off

[sentence rust-off]
SETINACTIVE rust

[sentence rust-show]
IF temp:42 ! 3 @rust-on

[sentence rust-on]
SETACTIVE rust

# ---------------------------------------------------------------------------
# Cold Svalt Town's people, in the original's order (scenario 1000000), in
# our own words. Flags follow the original: save:11 the commander (1 met,
# 2 the area's last reward given), save:71 the first area finished,
# save:12-20 and save:102 "met" (and moods) of the others, quest:4 the
# widow's ruby, quest:5 the old knight's errand, quest:6-10 the commander's
# missions.
#
# Temp flags, as the original uses them: temp:2 which box of the person
# talking is showing (closing it shows the next), temp:1 the answer to a
# menu, temp:15 "already answered" in a chain of IFs, temp:4/5 where a
# reward lands, temp:6-14 scratch, temp:16 the healer's last line,
# temp:17 which of the merchant's boxes is showing.

# Arriving through the warp gate plays its sound there.
[sentence arrive]
on=start
INITTRADE 0 2
GETENTRYPOINT temp:6
IF temp:6 = 50 @arrive-gate

[sentence arrive-gate]
PLAYSOUND 53 0 x:gate y:gate

# ---- The commander: the missions of the area -------------------------------

[message 100]
Welcome. I command the garrison here in Cold Svalt Town.

[message 101]
Remote Town's commander sent word ahead of you.
He spoke well of your skill, and I mean to put it to use.

[message 102]
First, let me tell you how things stand.

[message 103]
Goblins raided us not long ago. Raids are nothing new
up here, but the way they fight has changed.

[message 104]
They used to strike wherever they pleased. Now they come
in good order, as if someone were giving them commands.
I would like to believe I am wrong about that.

[message 105]
Your task is to thin out the goblins around town.
There are ruins nearby; do not go deep into them.
The goblins nest there and have reshaped the halls
to suit themselves.

[message 106]
Don't push yourself too hard.

[message 107]
Back again? No news has come in.
You have done good work.

[message 108]
While you stay in town, treat our people well.

[message 109]
There you are. I was hoping you'd come by.
A new report reached us a little while ago.

[message 110]
Our scouts say something enormous has made its lair
in the Cold Ruins, northwest of town.

[message 111]
Thanks to you, the goblins nearby have gone quiet.
Consider your first task done.

[message 112]
Here is your next one: clear the monsters
out of the Cold Ruins.

[message 113]
Some of my soldiers are on their way there too.
Good luck.

[message 114]
Well done. The soldiers told me how hard you fought.
Take this for your trouble.

[message 115]
Another matter: we have lost touch with the scouts
we sent to the Purgatory of Judgments. Go there,
find out what became of them, and destroy
any monsters you meet.

[message 116]
Between the golem in the Cold Ruins and everything else,
the monsters grow more restless by the day.
Watch yourself.

[message 117]
You're back in one piece! We owe you a great deal.
Here is your reward.

[message 118]
Putting the Cold Ruins and the Purgatory of Judgments
side by side, it looks as if the monsters start
by taking over old ruins and making them their dens.

[message 119]
Not far from here lie the Remains of Reincarnation.
We have nothing certain yet, but monsters are surely
stirring there as well.

[message 120]
So here is your new task: search the Remains of
Reincarnation and wipe out any monsters or demons
you come across.

[message 121]
I know you're worn out, but we need you.
It's the only way this town will know peace again.

[message 122]
Thank you. Your work never fails to impress me.
This is for you.

[message 123]
You say a passage deep in the Remains of Reincarnation
leads on to other lands. I'm sending scouts to look.

[message 124]
I want you to scout that land too.
If you find anything, report to me at once.

[message 125]
I'm relying on you. Good luck.

[message 126]
Good work. Your report caught my eye. I never knew
the Remains of Reincarnation led anywhere. This new
place may be the Immortal Remains of the old stories.

[message 127]
Likely as not, the monsters of this region keep their
stronghold there. I have a task for you.

[message 128]
Go to the Immortal Remains and search them.
Destroy whatever monsters you find.

[message 129]
This may be our last battle. Every soldier we have
has gone to the Immortal Remains. I'm counting on you
to fight alongside them.

[message 130]
Outstanding! Word is you brought down the gargoyles
of legend. You have our thanks. Please take this reward.

[message 131]
Peace seems to have come back to these parts. Rest
while you can, or, if you want more training, try the
Tower of Ordeal. The wizard on the west side of town
can tell you about it.

[message 133]
Your next orders have come in. Travel to the mining
town far to the south of Remote Town and report there.

