TALK msg:51 temp:41 1 -1 -1 -1

[sentence pip-choice]
IF temp:41 = 0 @pip-status
IF temp:41 = 1 @pip-tell
IF temp:41 = 2 @pip-swap
IF temp:41 = 3 @pip-done

[sentence pip-status]
